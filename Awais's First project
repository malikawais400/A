balance = 5000

while True:
    print("\n===== ATM =====")
    print("1. Check Balance")
    print("2. Deposit")
    print("3. Withdraw")
    print("4. Exit")

    choice = input("Choose: ")

    if choice == "1":
        print("Balance:", balance)

    elif choice == "2":
        amount = int(input("Enter Amount: "))
        balance += amount
        print("Deposit Successful!")

    elif choice == "3":
        amount = int(input("Enter Amount: "))
        if amount <= balance:
            balance -= amount
            print("Withdrawal Successful!")
        else:
            print("Insufficient Balance!")

    elif choice == "4":
        print("Thank You!")
        break
